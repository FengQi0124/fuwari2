---
/**
 * FontSetup.astro
 *
 * 根据 fontConfig 配置加载字体并设置 body 字体栈。
 * 新版使用 CDN 链接或本地字体文件，通过 <link> 标签和 @font-face 加载。
 */
import { fontConfig } from "@/config";

const SYSTEM_FONT_STACK = fontConfig.fallback.join(", ");

// 根据 selected 收集需要加载的字体
const selectedIds = fontConfig.enable && fontConfig.selected
	? Array.isArray(fontConfig.selected)
		? fontConfig.selected
		: [fontConfig.selected]
	: [];

// 获取选中字体的配置
const selectedFonts = selectedIds
	.filter(id => id !== "system")
	.map(id => (fontConfig.fonts as Record<string, any>)[id])
	.filter(Boolean);

// 生成 body 的 font-family 值
const bodyFontFamily = selectedFonts.length > 0
	? [...selectedFonts.map(f => f.family), ...fontConfig.fallback].join(", ")
	: SYSTEM_FONT_STACK;
---

<!-- 加载选中字体的 CSS/字体文件 -->
{fontConfig.enable && selectedFonts.map((font) => (
	font.src.startsWith("/") ? (
		// 本地字体文件 - 使用 @font-face
		<style set:html={`
			@font-face {
				font-family: '${font.family}';
				src: url('${font.src}') format('${font.format || 'woff2'}');
				font-weight: ${font.weight || 400};
				font-display: ${font.display || 'swap'};
			}
		`} />
	) : (
		// CDN 字体 - 使用 <link> 加载 CSS
		<link rel="stylesheet" href={font.src} />
	)
))}

<!-- 设置 body 字体栈 -->
{fontConfig.enable && (
	<style set:html={`
		body {
			font-family: ${bodyFontFamily};
		}
	`} />
)}
